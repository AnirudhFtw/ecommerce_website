# Required for the API/database connection and JWT security.
DATABASE_URL=
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional until Razorpay is enabled. Online checkout/refunds report a clear
# configuration error while these values are blank.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional until email verification/password recovery is enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
FRONTEND_URL=

# Optional until phone verification is enabled.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Pydantic expects a JSON array here.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
